<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vinebot_bringup</name>
  <version>0.1.0</version>
  <description>Real VineBot bringup: Roboteq motor controller (ros2_control), PS4 joystick with an L1 deadman, twist_mux (joystick over autonomy, PS4 O button = stop) and the robot model from vinebot_description.</description>
  <maintainer email="vashiyug9@users.noreply.github.com">vashiyug9-max</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>roboteq</exec_depend>
  <exec_depend>ps4_ros2</exec_depend>
  <exec_depend>vinebot_description</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
